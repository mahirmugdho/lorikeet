# Lorikeet settings. Copy to .env and edit; .env is gitignored.
# There are no secrets here: Lorikeet runs entirely on your machine (ADR 0002, ADR 0007).
# Load with: uv run --env-file .env lorikeet   (the app arrives in Phase 1)

# Phase 1: which webcam OpenCV opens. 0 is often the built-in camera, or an iPhone via Continuity Camera.
LORIKEET_CAMERA_INDEX=0

# Phase 1: which display is the projector (0 is the main screen). The projector must be an
# extended display, not a mirror, or calibration is off by the scale difference.
LORIKEET_DISPLAY_INDEX=1

# Phase 1: where this room's calibration (the camera-to-projector homography) is saved.
LORIKEET_CALIBRATION_PATH=.lorikeet/calibration.json

# Phase 1: sticky-note colours to detect, comma-separated.
LORIKEET_NOTE_COLORS=yellow,pink,green,blue

# Phase 1: save raw camera frames to .lorikeet/debug-frames/ for debugging.
# Off by default. Frames can contain people (docs/legal/privacy.md).
LORIKEET_DEBUG_SAVE_FRAMES=0

# Phase 2: frames a note must hold still before it counts as placed (debounce against hands).
LORIKEET_STABLE_FRAMES=5
