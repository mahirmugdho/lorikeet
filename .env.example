# Lorikeet settings. Copy to .env and edit; .env is gitignored.
# There are no secrets here: Lorikeet runs entirely on your machine (ADR 0002, ADR 0007).
# Load with: uv run --env-file .env lorikeet   (uv run lorikeet --help lists the options)

# Phase 1: which webcam OpenCV opens. 0 is often the built-in camera, or an iPhone via Continuity Camera.
LORIKEET_CAMERA_INDEX=0

# Phase 1: which display is the projector (0 is the main screen). The projector must be an
# extended display, not a mirror, or calibration is off by the scale difference.
LORIKEET_DISPLAY_INDEX=1

# Phase 1: where the calibration (the camera-to-projector homography) is saved.
LORIKEET_CALIBRATION_PATH=.lorikeet/calibration.json

# Phase 1: colours of sticky pieces to detect, comma-separated. Each is calibrated per room,
# because lighting and surfaces change how a colour looks. Adding one is a setting, not code.
LORIKEET_PIECE_COLORS=yellow,pink,green,blue

# Phase 1: save raw camera frames to .lorikeet/debug-frames/ for debugging.
# Off by default. Frames can contain people (docs/legal/privacy.md).
LORIKEET_DEBUG_SAVE_FRAMES=0

# Phase 2: seconds a piece must hold still before it's SETTLED (placed). Seconds, not frames,
# because webcams drop frames in dim rooms. 0.2 s is the old 5 frames at 25 fps.
LORIKEET_SETTLE_SECONDS=0.2

# Phase 2: seconds a settled piece stays HIDDEN (say, behind a hand) before it's removed.
LORIKEET_HIDDEN_SECONDS=2

# Sim input: how many projector pixels a real note covers on your wall. The sim makes its notes
# this size, so levels built with the sim fit real notes. 100 is a guess until it's measured.
LORIKEET_NOTE_SIZE=100
